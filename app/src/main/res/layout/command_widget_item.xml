<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">
    <TextView
        android:id="@+id/widget_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FF252B34"
        android:textSize="14sp"
        android:textStyle="medium"
        android:paddingEnd="8dp" />
    <ProgressBar
        android:id="@+id/widget_loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminateTint="#FF0F766E"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_run"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="66dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/widget_action_bg"
        android:text="اجرا"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>